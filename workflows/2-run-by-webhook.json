      "parameters": {
        "jsCode": "// Everything in the two data tables, for a look from outside n8n.\nconst rows = (name) => $(name).all().map((item) => item.json).filter((row) => row && row.run_id);\nreturn [{ json: { companies: rows('Companies'), runs: rows('Runs') } }];"
