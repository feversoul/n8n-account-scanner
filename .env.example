# Any long random string. n8n encrypts stored credentials with it.
N8N_ENCRYPTION_KEY=
# The secret for the optional webhooks (header X-Scanner-Key).
SCANNER_KEY=
# The model API: an address that speaks the OpenAI Responses format with the
# built-in web search tool, a model that supports it, and your key.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL=gpt-6-astra
MODEL_API_KEY=
# Optional: what "Execute workflow" looks for. The form and the webhook send their own.
LOCATION=
INTENT_SIGNAL=
# Port of the n8n editor on this machine.
N8N_PORT=5678
